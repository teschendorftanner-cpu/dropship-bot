# ── eBay Developer account (https://developer.ebay.com) ──────────────────────
EBAY_APP_ID=your_app_id
EBAY_CERT_ID=your_cert_id
EBAY_RUNAME=your_runame

# eBay OAuth refresh token — run get_token.py once to generate this
EBAY_REFRESH_TOKEN=your_refresh_token

# ── CJ Dropshipping (https://app.cjdropshipping.com → API page) ───────────────
CJ_API_KEY=your_cj_api_key

# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# ── Profit settings ───────────────────────────────────────────────────────────
MIN_MARGIN_PERCENT=25
MARKUP_PERCENT=60
EBAY_FEE_PERCENT=15.5
MAX_LISTINGS=50
RESEARCH_INTERVAL_HOURS=6
PRICE_SYNC_INTERVAL_HOURS=2
ORDER_POLL_MINUTES=10
